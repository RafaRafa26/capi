# Owner role — migrations, seed, and the auth lookup by e-mail. Bypasses RLS.
DATABASE_URL="postgresql://capi:capi_local@localhost:5432/capi?schema=public"

# Application role — everything else. Subject to RLS (see src/db/client.ts).
# Password matches the `capi_app` role created by src/db/migrations/*_rls.
DATABASE_URL_APP="postgresql://capi_app:capi_app_local@localhost:5432/capi?schema=public"
