# Owner role — migrations, seed, and the auth lookup by e-mail. Bypasses RLS.
DATABASE_URL="postgresql://capi:capi_local@localhost:5432/capi?schema=public"

# Application role — everything else. Subject to RLS (see src/db/client.ts).
# Password matches the `capi_app` role created by src/db/migrations/*_rls.
DATABASE_URL_APP="postgresql://capi_app:capi_app_local@localhost:5432/capi?schema=public"

# Optional: set to 1 to log how long each database transaction takes (slow-page
# diagnosis). Caller names are readable under `next dev`; minified in a build.
# DB_TIMING=1

# MCP / OAuth (Claude connector at /api/mcp). Public URL the app is reached
# at — goes into the OAuth metadata. Optional: derived from the request
# (Vercel's forwarded headers) when unset.
# APP_URL="https://app.example.com"
# Hosts allowed as OAuth redirect URIs, comma-separated (HTTPS only;
# localhost over HTTP is always allowed for development tools).
# OAUTH_REDIRECT_HOSTS="claude.ai,claude.com"
