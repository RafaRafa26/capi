// Domain model — see ARQUITETURA.md §5.
//
// Conventions:
// - Every monetary value is an integer in cents (AD-07). Never Float/Decimal.
// - Every table carrying `organizationId` has RLS enabled (AD-02) — see
//   src/db/migrations/*_rls/migration.sql.
// - snake_case column/table names in the database, camelCase in the client.

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

enum UserRole {
  ADMIN
  OPERATOR

  @@map("user_role")
}

enum PersonType {
  INDIVIDUAL
  COMPANY

  @@map("person_type")
}

enum ContactType {
  CLIENT
  SUPPLIER
  BENEFICIARY
  EMPLOYEE
  PARTNER

  @@map("contact_type")
}

enum AccountKind {
  CHECKING
  SAVINGS_POCKET

  @@map("account_kind")
}

enum CategoryType {
  INCOME
  EXPENSE

  @@map("category_type")
}

// -------------------------------------------------------------- entities

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  document  String
  createdAt DateTime @default(now()) @map("created_at")

  users        User[]
  contacts     Contact[]
  bankAccounts BankAccount[]
  categories   Category[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  email          String   @unique
  passwordHash   String   @map("password_hash")
  role           UserRole @default(ADMIN)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  sessions     Session[]

  @@index([organizationId])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// `name` is the display name: the person's name for an INDIVIDUAL, the trade
// name ("nome fantasia") for a COMPANY. `legalName` ("razão social") only
// applies to COMPANY.
model Contact {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  name           String
  legalName      String?     @map("legal_name")
  document       String
  personType     PersonType  @map("person_type")
  contactType    ContactType @map("contact_type")
  phone          String?
  email          String?
  city           String?
  state          String?
  bankDetails    Json?       @map("bank_details")
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, document])
  @@index([organizationId])
  @@map("contacts")
}

// Every row here is one of the organization's own accounts — there is no
// "third-party account" concept at this level. Documenting where a manual
// write-off landed (RN-20) belongs to Liquidacao when Fase 6 is built, not
// to this table.
model BankAccount {
  id               String      @id @default(uuid()) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  name             String
  bank             String
  branchNumber     String      @map("branch_number")
  accountNumber    String      @map("account_number")
  kind             AccountKind @default(CHECKING)
  holderType       PersonType  @map("holder_type")
  controlStartDate DateTime    @map("control_start_date") @db.Date
  // Balance at the end of the day before `controlStartDate` — the opening
  // balance the app's own ledger starts counting from.
  initialBalance   Int         @default(0) @map("initial_balance")
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("bank_accounts")
}

// A subcategory is a Category with a non-null `parentId`. It always shares
// its parent's `type` — see src/modules/categories/service.ts.
model Category {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  parentId       String?      @map("parent_id") @db.Uuid
  name           String
  type           CategoryType
  createdAt      DateTime     @default(now()) @map("created_at")

  organization  Organization @relation(fields: [organizationId], references: [id])
  parent        Category?    @relation("CategorySubcategories", fields: [parentId], references: [id])
  subcategories Category[]   @relation("CategorySubcategories")

  @@unique([organizationId, parentId, name])
  @@index([organizationId])
  @@index([parentId])
  @@map("categories")
}
