// Domain model — see ARQUITETURA.md §5.
//
// Conventions:
// - Every monetary value is an integer in cents (AD-07). Never Float/Decimal.
// - Every table carrying `organizationId` has RLS enabled (AD-02) — see
//   src/db/migrations/*_rls/migration.sql.
// - snake_case column/table names in the database, camelCase in the client.

generator client {
  provider        = "prisma-client"
  output          = "./generated"
  // Makes `relationLoadStrategy: "join"` the default: a nested `include` loads
  // in a single SQL query (LATERAL JOIN + JSON) instead of one round trip per
  // relation — which is what dominates page latency against a remote database.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

// Per-organization role, carried by Membership (ARQUITETURA.md §3, permissions
// table): VIEWER only reads, OPERATOR runs the day-to-day, ADMIN also manages
// people and the organization itself.
enum UserRole {
  ADMIN
  OPERATOR
  VIEWER

  @@map("user_role")
}

enum PersonType {
  INDIVIDUAL
  COMPANY

  @@map("person_type")
}

enum ContactType {
  CLIENT
  SUPPLIER
  BENEFICIARY
  EMPLOYEE
  PARTNER

  @@map("contact_type")
}

enum AccountKind {
  CHECKING
  SAVINGS_POCKET

  @@map("account_kind")
}

enum CategoryType {
  INCOME
  EXPENSE

  @@map("category_type")
}

enum PaymentMethod {
  BOLETO
  PIX
  CREDIT_CARD
  BANK_TRANSFER

  @@map("payment_method")
}

enum BillingFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY

  @@map("billing_frequency")
}

enum BillingType {
  INSTALLMENTS
  RECURRING

  @@map("billing_type")
}

// A perna de uma transferência (RN-15): OUT sai da conta de origem, IN entra
// na de destino.
enum TransferDirection {
  OUT
  IN

  @@map("transfer_direction")
}

enum EntryType {
  RECEIVABLE
  PAYABLE
  TRANSFER

  @@map("entry_type")
}

enum EntryStatus {
  FORECAST
  PARTIAL
  SETTLED
  CANCELED

  @@map("entry_status")
}

enum AllocationMode {
  PERCENTAGE
  FIXED_AMOUNT

  @@map("allocation_mode")
}

enum BankTransactionStatus {
  PENDING
  RECONCILED
  IGNORED

  @@map("bank_transaction_status")
}

enum SettlementOrigin {
  STATEMENT
  MANUAL

  @@map("settlement_origin")
}

// -------------------------------------------------------------- entities

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  // CNPJ or CPF, digits only — one account per company across the system.
  document  String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  memberships      Membership[]
  invitations      Invitation[]
  contacts         Contact[]
  bankAccounts     BankAccount[]
  categories       Category[]
  sales            Sale[]
  entries          Entry[]
  allocations      Allocation[]
  imports          Import[]
  bankTransactions BankTransaction[]
  settlements      Settlement[]
  payouts          Payout[]
  markers          Marker[]

  @@map("organizations")
}

// A person, global across organizations: the same login can belong to
// several companies, each through its own Membership. Which organization a
// request operates in comes from the URL (/o/<organizationId>/...), never
// from the user — so different tabs can have different companies open.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  memberships        Membership[]
  sessions           Session[]
  invitationsCreated Invitation[] @relation("InvitationInvitedBy")

  @@map("users")
}

// The user ↔ organization link, and the role the user has in it.
model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           UserRole @default(OPERATOR)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

// Invitation to join an organization, delivered as a link the admin copies
// and sends by hand (there's no outbound e-mail yet). Only the token's hash
// is stored, same as sessions; "copy the link again" regenerates the token.
model Invitation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String
  role           UserRole
  tokenHash      String    @unique @map("token_hash")
  invitedById    String    @map("invited_by_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  invitedBy    User         @relation("InvitationInvitedBy", fields: [invitedById], references: [id])

  @@index([organizationId])
  @@map("invitations")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// `name` is the display name: the person's name for an INDIVIDUAL, the trade
// name ("nome fantasia") for a COMPANY. `legalName` ("razão social") only
// applies to COMPANY.
//
// `document` is nullable only for contacts quick-added from the new-sale
// screen (name only, see src/modules/contacts/service.ts#createQuickClient)
// — the full contact registration screen still requires it at the zod layer
// in src/modules/contacts/schema.ts. Postgres treats every NULL as distinct
// for the unique index below, so multiple quick-added contacts can coexist.
model Contact {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  name           String
  legalName      String?     @map("legal_name")
  document       String?
  personType     PersonType  @map("person_type")
  contactType    ContactType @map("contact_type")
  phone          String?
  email          String?
  city           String?
  state          String?
  bankDetails    Json?       @map("bank_details")
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now()) @map("created_at")

  organization           Organization @relation(fields: [organizationId], references: [id])
  sales                  Sale[]       @relation("SaleContact")
  entries                Entry[]      @relation("EntryContact")
  beneficiaryAllocations Allocation[] @relation("AllocationBeneficiary")
  payouts                Payout[]     @relation("PayoutBeneficiary")

  @@unique([organizationId, document])
  @@index([organizationId])
  @@map("contacts")
}

// Every row here is one of the organization's own accounts — there is no
// "third-party account" concept at this level. Documenting where a manual
// write-off landed (RN-20) belongs to Liquidacao when Fase 6 is built, not
// to this table.
model BankAccount {
  id               String      @id @default(uuid()) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  name             String
  bank             String
  branchNumber     String      @map("branch_number")
  accountNumber    String      @map("account_number")
  kind             AccountKind @default(CHECKING)
  holderType       PersonType  @map("holder_type")
  controlStartDate DateTime    @map("control_start_date") @db.Date
  // Balance at the end of the day before `controlStartDate` — the opening
  // balance the app's own ledger starts counting from.
  initialBalance   Int         @default(0) @map("initial_balance")
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now()) @map("created_at")

  organization     Organization      @relation(fields: [organizationId], references: [id])
  sales            Sale[]
  entries          Entry[]
  imports          Import[]
  bankTransactions BankTransaction[]

  @@index([organizationId])
  @@map("bank_accounts")
}

// A subcategory is a Category with a non-null `parentId`. It always shares
// its parent's `type` — see src/modules/categories/service.ts.
model Category {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  parentId       String?      @map("parent_id") @db.Uuid
  name           String
  type           CategoryType
  createdAt      DateTime     @default(now()) @map("created_at")

  organization  Organization @relation(fields: [organizationId], references: [id])
  parent        Category?    @relation("CategorySubcategories", fields: [parentId], references: [id])
  subcategories Category[]   @relation("CategorySubcategories")
  sales         Sale[]
  entries       Entry[]

  @@unique([organizationId, parentId, name])
  @@index([organizationId])
  @@index([parentId])
  @@map("categories")
}

// A Venda (Sale) groups its installments. Repasse (Allocation) is optional —
// no rows means the money is entirely the organization's own, per RN-04.
model Sale {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  contactId         String           @map("contact_id") @db.Uuid
  categoryId        String           @map("category_id") @db.Uuid
  bankAccountId     String           @map("bank_account_id") @db.Uuid
  description       String
  // For INSTALLMENTS, the total to be split across `installmentsCount`
  // entries (RN-17). For RECURRING, the fixed amount charged every period —
  // see src/modules/sales/domain.ts#generateRecurringInstallments.
  totalAmount       Int              @map("total_amount")
  paymentMethod     PaymentMethod    @map("payment_method")
  billingType       BillingType      @default(INSTALLMENTS) @map("billing_type")
  installmentsCount Int              @default(1) @map("installments_count")
  billingFrequency  BillingFrequency @default(MONTHLY) @map("billing_frequency")
  firstDueDate      DateTime         @map("first_due_date") @db.Date
  // RECURRING only: null means indeterminado (open-ended) — entries are
  // generated in a rolling window instead (RECURRING_ROLLING_WINDOW). See
  // the "Pendência para a Fase 6" note in ARQUITETURA.md §5.1.
  recurrenceEndDate DateTime?        @map("recurrence_end_date") @db.Date
  createdAt         DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  contact      Contact      @relation("SaleContact", fields: [contactId], references: [id])
  category     Category     @relation(fields: [categoryId], references: [id])
  bankAccount  BankAccount  @relation(fields: [bankAccountId], references: [id])
  entries      Entry[]
  allocations  Allocation[]

  @@index([organizationId])
  @@map("sales")
}

// One installment. `saleId`/`installmentNumber` are set for every entry in
// this slice — Entry also models standalone payables/transfers from Fase 5+,
// which is why they're nullable rather than the primary key.
model Entry {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  saleId            String?            @map("sale_id") @db.Uuid
  installmentNumber Int?               @map("installment_number")
  // Nulos só na transferência (RN-15): ela não tem contato nem categoria —
  // a recebimento/pagamento o serviço sempre exige os dois.
  contactId         String?            @map("contact_id") @db.Uuid
  categoryId        String?            @map("category_id") @db.Uuid
  // Nula no repasse (Payout): a conta de onde ele sai só é decidida na
  // conciliação, que não filtra lançamento por conta. Nos demais lançamentos
  // é a conta prevista de recebimento/pagamento.
  bankAccountId     String?            @map("bank_account_id") @db.Uuid
  type              EntryType
  // Só na transferência: qual perna é esta — a saída da conta de origem ou a
  // entrada na de destino. A perna OUT guarda o id da IN (transferPair); da
  // IN se chega à OUT por transferPairOf.
  transferDirection TransferDirection? @map("transfer_direction")
  transferPairId    String?            @unique @map("transfer_pair_id") @db.Uuid
  status            EntryStatus        @default(FORECAST)
  description       String
  dueDate           DateTime           @map("due_date") @db.Date
  amount            Int
  interest          Int                @default(0)
  fine              Int                @default(0)
  discount          Int                @default(0)
  settledAmount     Int?               @map("settled_amount")
  paymentMethod     PaymentMethod      @map("payment_method")
  // Acompanhamento (RN-36): o marcador atual e uma observação livre — o
  // retorno de cobrança, num a receber. Saem nos relatórios exportados.
  markerId          String?            @map("marker_id") @db.Uuid
  notes             String?
  // Quando o marcador ou a observação mudaram pela última vez.
  notesUpdatedAt    DateTime?          @map("notes_updated_at")
  createdAt         DateTime           @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id])
  sale           Sale?        @relation(fields: [saleId], references: [id])
  marker         Marker?      @relation(fields: [markerId], references: [id], onDelete: SetNull)
  contact        Contact?     @relation("EntryContact", fields: [contactId], references: [id], onDelete: Restrict)
  category       Category?    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transferPair   Entry?       @relation("TransferPair", fields: [transferPairId], references: [id], onDelete: SetNull)
  transferPairOf Entry?       @relation("TransferPair")
  bankAccount    BankAccount? @relation(fields: [bankAccountId], references: [id])
  settlements    Settlement[]
  payout         Payout?

  // Contas a receber/pagar and the dashboard: WHERE type (+ status) ORDER BY
  // due_date. Also covers plain organization_id lookups (leading column).
  @@index([organizationId, type, dueDate])
  @@index([saleId])
  @@index([markerId])
  @@map("entries")
}

// A repasse line. `percentage` is only set when `mode` is PERCENTAGE;
// `amount` is always the computed cents value, in both modes.
// Marcador de acompanhamento de um lançamento (RN-36) — "Cobrado, sem
// retorno", "Aguardando nota fiscal"... Cada lista é de um lado: a receber
// (RECEIVABLE) ou a pagar (PAYABLE). Toda organização nasce com os padrões
// de src/modules/markers/defaults.ts e pode editá-los à vontade.
model Marker {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  type           EntryType
  name           String
  // Chave da paleta em src/lib/marker-colors.ts, não um código de cor.
  color          String
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  entries      Entry[]

  @@unique([organizationId, type, name])
  @@map("markers")
}

model Allocation {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  saleId         String         @map("sale_id") @db.Uuid
  beneficiaryId  String         @map("beneficiary_id") @db.Uuid
  mode           AllocationMode
  percentage     Int?
  amount         Int
  order          Int
  createdAt      DateTime       @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  sale         Sale         @relation(fields: [saleId], references: [id])
  beneficiary  Contact      @relation("AllocationBeneficiary", fields: [beneficiaryId], references: [id])

  @@index([organizationId])
  @@index([saleId])
  @@map("allocations")
}

// Marca uma Entry PAYABLE como repasse de custódia — sem esta linha, o saldo
// disponível do favorecido não sabe que aquele valor já foi reservado/pago
// (RN-09/RN-10). `amount` é o valor gerado no repasse; pendente/realizado são
// derivados do status/settledAmount da Entry ligada, não guardados aqui.
model Payout {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  beneficiaryId  String   @map("beneficiary_id") @db.Uuid
  entryId        String   @unique @map("entry_id") @db.Uuid
  amount         Int
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  beneficiary  Contact      @relation("PayoutBeneficiary", fields: [beneficiaryId], references: [id])
  entry        Entry        @relation(fields: [entryId], references: [id])

  @@index([organizationId])
  @@index([beneficiaryId])
  @@map("payouts")
}

// One uploaded OFX file. Its transactions land in BankTransaction, deduped
// at the database level by (bankAccountId, bankReference) — see RN-16.
model Import {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  bankAccountId  String    @map("bank_account_id") @db.Uuid
  fileName       String    @map("file_name")
  periodStart    DateTime? @map("period_start") @db.Date
  periodEnd      DateTime? @map("period_end") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at")

  organization     Organization      @relation(fields: [organizationId], references: [id])
  bankAccount      BankAccount       @relation(fields: [bankAccountId], references: [id])
  bankTransactions BankTransaction[]

  @@index([organizationId])
  @@map("imports")
}

// The reality of the bank statement — one row per OFX <STMTTRN>. `amount`
// keeps the bank's sign (credit positive, debit negative). Unique per
// (bankAccountId, bankReference) so reimporting the same file is a no-op
// (RN-16) — enforced by the database, not only by the import service.
model BankTransaction {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  bankAccountId  String                @map("bank_account_id") @db.Uuid
  importId       String                @map("import_id") @db.Uuid
  bankReference  String                @map("bank_reference")
  date           DateTime              @db.Date
  amount         Int
  description    String
  status         BankTransactionStatus @default(PENDING)
  createdAt      DateTime              @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  bankAccount  BankAccount  @relation(fields: [bankAccountId], references: [id])
  import       Import       @relation(fields: [importId], references: [id])
  settlements  Settlement[]

  @@unique([bankAccountId, bankReference])
  @@index([organizationId])
  @@index([importId])
  @@map("bank_transactions")
}

// The link between a bank statement (or a manual write-off) and an Entry —
// the only way an Entry's status/settledAmount ever changes after creation.
// A bank transaction can settle more than one Entry (RN-07, e.g. one
// transfer paying two installments of the same sale); an Entry can
// accumulate more than one Settlement over time (partial payments). There is
// no separate custody ledger — a beneficiary's available balance is computed
// on demand from these rows (see src/modules/settlements/service.ts), and an
// Entry's own aggregate (status/settledAmount) is recomputed from its
// Settlement rows on every create/undo instead of being incrementally
// patched, so it can never drift.
model Settlement {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  entryId           String           @map("entry_id") @db.Uuid
  bankTransactionId String?          @map("bank_transaction_id") @db.Uuid
  origin            SettlementOrigin
  settledAmount     Int              @map("settled_amount")
  interest          Int              @default(0)
  fine              Int              @default(0)
  discount          Int              @default(0)
  settledAt         DateTime         @map("settled_at") @db.Date
  note              String?
  createdAt         DateTime         @default(now()) @map("created_at")

  organization    Organization     @relation(fields: [organizationId], references: [id])
  entry           Entry            @relation(fields: [entryId], references: [id])
  bankTransaction BankTransaction? @relation(fields: [bankTransactionId], references: [id])

  @@index([organizationId])
  @@index([entryId])
  @@index([bankTransactionId])
  @@map("settlements")
}
