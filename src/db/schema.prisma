// Domain model — see ARQUITETURA.md §5.
//
// Conventions:
// - Every monetary value is an integer in cents (AD-07). Never Float/Decimal.
// - Every table carrying `organizationId` has RLS enabled (AD-02) — see
//   src/db/migrations/*_rls/migration.sql.
// - snake_case column/table names in the database, camelCase in the client.

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

enum UserRole {
  ADMIN
  OPERATOR

  @@map("user_role")
}

enum PersonType {
  INDIVIDUAL
  COMPANY

  @@map("person_type")
}

enum ContactType {
  CLIENT
  SUPPLIER
  BENEFICIARY
  EMPLOYEE
  PARTNER

  @@map("contact_type")
}

enum AccountKind {
  CHECKING
  SAVINGS_POCKET

  @@map("account_kind")
}

enum CategoryType {
  INCOME
  EXPENSE

  @@map("category_type")
}

enum PaymentMethod {
  BOLETO
  PIX
  CREDIT_CARD
  BANK_TRANSFER

  @@map("payment_method")
}

enum BillingFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY

  @@map("billing_frequency")
}

enum BillingType {
  INSTALLMENTS
  RECURRING

  @@map("billing_type")
}

enum EntryType {
  RECEIVABLE
  PAYABLE
  TRANSFER

  @@map("entry_type")
}

enum EntryStatus {
  FORECAST
  PARTIAL
  SETTLED
  CANCELED

  @@map("entry_status")
}

enum AllocationMode {
  PERCENTAGE
  FIXED_AMOUNT

  @@map("allocation_mode")
}

// -------------------------------------------------------------- entities

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  document  String
  createdAt DateTime @default(now()) @map("created_at")

  users        User[]
  contacts     Contact[]
  bankAccounts BankAccount[]
  categories   Category[]
  sales        Sale[]
  entries      Entry[]
  allocations  Allocation[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  email          String   @unique
  passwordHash   String   @map("password_hash")
  role           UserRole @default(ADMIN)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  sessions     Session[]

  @@index([organizationId])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// `name` is the display name: the person's name for an INDIVIDUAL, the trade
// name ("nome fantasia") for a COMPANY. `legalName` ("razão social") only
// applies to COMPANY.
//
// `document` is nullable only for contacts quick-added from the new-sale
// screen (name only, see src/modules/contacts/service.ts#createQuickClient)
// — the full contact registration screen still requires it at the zod layer
// in src/modules/contacts/schema.ts. Postgres treats every NULL as distinct
// for the unique index below, so multiple quick-added contacts can coexist.
model Contact {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  name           String
  legalName      String?     @map("legal_name")
  document       String?
  personType     PersonType  @map("person_type")
  contactType    ContactType @map("contact_type")
  phone          String?
  email          String?
  city           String?
  state          String?
  bankDetails    Json?       @map("bank_details")
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now()) @map("created_at")

  organization           Organization @relation(fields: [organizationId], references: [id])
  sales                  Sale[]       @relation("SaleContact")
  entries                Entry[]      @relation("EntryContact")
  beneficiaryAllocations Allocation[] @relation("AllocationBeneficiary")

  @@unique([organizationId, document])
  @@index([organizationId])
  @@map("contacts")
}

// Every row here is one of the organization's own accounts — there is no
// "third-party account" concept at this level. Documenting where a manual
// write-off landed (RN-20) belongs to Liquidacao when Fase 6 is built, not
// to this table.
model BankAccount {
  id               String      @id @default(uuid()) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  name             String
  bank             String
  branchNumber     String      @map("branch_number")
  accountNumber    String      @map("account_number")
  kind             AccountKind @default(CHECKING)
  holderType       PersonType  @map("holder_type")
  controlStartDate DateTime    @map("control_start_date") @db.Date
  // Balance at the end of the day before `controlStartDate` — the opening
  // balance the app's own ledger starts counting from.
  initialBalance   Int         @default(0) @map("initial_balance")
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  sales        Sale[]
  entries      Entry[]

  @@index([organizationId])
  @@map("bank_accounts")
}

// A subcategory is a Category with a non-null `parentId`. It always shares
// its parent's `type` — see src/modules/categories/service.ts.
model Category {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  parentId       String?      @map("parent_id") @db.Uuid
  name           String
  type           CategoryType
  createdAt      DateTime     @default(now()) @map("created_at")

  organization  Organization @relation(fields: [organizationId], references: [id])
  parent        Category?    @relation("CategorySubcategories", fields: [parentId], references: [id])
  subcategories Category[]   @relation("CategorySubcategories")
  sales         Sale[]
  entries       Entry[]

  @@unique([organizationId, parentId, name])
  @@index([organizationId])
  @@index([parentId])
  @@map("categories")
}

// A Venda (Sale) groups its installments. Repasse (Allocation) is optional —
// no rows means the money is entirely the organization's own, per RN-04.
model Sale {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  contactId         String           @map("contact_id") @db.Uuid
  categoryId        String           @map("category_id") @db.Uuid
  bankAccountId     String           @map("bank_account_id") @db.Uuid
  description       String
  // For INSTALLMENTS, the total to be split across `installmentsCount`
  // entries (RN-17). For RECURRING, the fixed amount charged every period —
  // see src/modules/sales/domain.ts#generateRecurringInstallments.
  totalAmount       Int              @map("total_amount")
  paymentMethod     PaymentMethod    @map("payment_method")
  billingType       BillingType      @default(INSTALLMENTS) @map("billing_type")
  installmentsCount Int              @default(1) @map("installments_count")
  billingFrequency  BillingFrequency @default(MONTHLY) @map("billing_frequency")
  firstDueDate      DateTime         @map("first_due_date") @db.Date
  // RECURRING only: null means indeterminado (open-ended) — entries are
  // generated in a rolling window instead (RECURRING_ROLLING_WINDOW). See
  // the "Pendência para a Fase 6" note in ARQUITETURA.md §5.1.
  recurrenceEndDate DateTime?        @map("recurrence_end_date") @db.Date
  createdAt         DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  contact      Contact      @relation("SaleContact", fields: [contactId], references: [id])
  category     Category     @relation(fields: [categoryId], references: [id])
  bankAccount  BankAccount  @relation(fields: [bankAccountId], references: [id])
  entries      Entry[]
  allocations  Allocation[]

  @@index([organizationId])
  @@map("sales")
}

// One installment. `saleId`/`installmentNumber` are set for every entry in
// this slice — Entry also models standalone payables/transfers from Fase 5+,
// which is why they're nullable rather than the primary key.
model Entry {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  saleId            String?       @map("sale_id") @db.Uuid
  installmentNumber Int?          @map("installment_number")
  contactId         String        @map("contact_id") @db.Uuid
  categoryId        String        @map("category_id") @db.Uuid
  bankAccountId     String        @map("bank_account_id") @db.Uuid
  type              EntryType
  status            EntryStatus   @default(FORECAST)
  description       String
  dueDate           DateTime      @map("due_date") @db.Date
  amount            Int
  interest          Int           @default(0)
  fine              Int           @default(0)
  discount          Int           @default(0)
  settledAmount     Int?          @map("settled_amount")
  paymentMethod     PaymentMethod @map("payment_method")
  createdAt         DateTime      @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  sale         Sale?        @relation(fields: [saleId], references: [id])
  contact      Contact      @relation("EntryContact", fields: [contactId], references: [id])
  category     Category     @relation(fields: [categoryId], references: [id])
  bankAccount  BankAccount  @relation(fields: [bankAccountId], references: [id])

  @@index([organizationId])
  @@index([saleId])
  @@map("entries")
}

// A repasse line. `percentage` is only set when `mode` is PERCENTAGE;
// `amount` is always the computed cents value, in both modes.
model Allocation {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  saleId         String         @map("sale_id") @db.Uuid
  beneficiaryId  String         @map("beneficiary_id") @db.Uuid
  mode           AllocationMode
  percentage     Int?
  amount         Int
  order          Int
  createdAt      DateTime       @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  sale         Sale         @relation(fields: [saleId], references: [id])
  beneficiary  Contact      @relation("AllocationBeneficiary", fields: [beneficiaryId], references: [id])

  @@index([organizationId])
  @@index([saleId])
  @@map("allocations")
}
